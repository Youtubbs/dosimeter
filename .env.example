AWS_PROFILE=
AWS_REGION=

# Read by the ingestion modules and by the typed settings.
AWS_CORPUS_BUCKET_NAME=
AWS_PACKET_BUCKET_NAME=
# Required by the typed settings, so any command can start. you dont have to put anything for local database work.
DOSIMETER_MODELS__REASONING=
DOSIMETER_MODELS__FAST=
DOSIMETER_MODELS__MULTIMODAL=
DOSIMETER_MODELS__JUDGE=
# Duplicate embedding model env variables because refactoring code is put off until later.
DOSIMETER_MODELS__EMBEDDING=
BEDROCK_EMBED_MODEL_ID=
#
# The knowledge base is in memory for now
DOSIMETER_KNOWLEDGE_BASE_ID=in-memory
BEDROCK_KB_ID=in-memory

DOSIMETER_GUARDRAIL_ID=
# Local database (docker compose). The deployed path uses IAM authentication.
DOSIMETER_DB_HOST=localhost
DOSIMETER_DB_PORT=55432
DOSIMETER_DB_NAME=dosimeter
DOSIMETER_DB_USER=dosimeter
DOSIMETER_DB_USE_IAM_AUTH=false
DOSIMETER_DB_PASSWORD=dosimeter_local_dev
DOSIMETER_DB_SSLMODE=prefer

DOSIMETER_TOOL_API_BASE_URL=http://127.0.0.1:8080
DOSIMETER_TOOL_API_DEV_IDENTITY=true
